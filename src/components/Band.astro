---
import { SITE } from '../data/site';
interface Props { title?: string }
const { title = 'New rescue adventures every week!' } = Astro.props;
---
<section class="band reveal">
  <h2>{title}</h2>
  <a class="btn btn--red" href={SITE.links.subscribe} target="_blank" rel="noopener">Subscribe on YouTube</a>
</section>
