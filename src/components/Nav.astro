---
import { SITE } from '../data/site';
const yol = Astro.url.pathname;
---
<header class="nav" id="nav">
  <a class="nav__logo" href="/" aria-label="Vumibo home"><img src="/img/logo.webp" alt="Vumibo" width="900" height="261" /></a>
  <nav class="nav__links" aria-label="Main">
    {SITE.nav.map((n) => <a href={n.href} aria-current={yol.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <a class="btn btn--red btn--sm" href={SITE.links.subscribe} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.4-1.6.5-3.2.5-4.8s-.1-3.2-.5-4.8zM9.7 15.1V8.9l5.8 3.1-5.8 3.1z"/></svg>
    <span>Subscribe</span>
  </a>
  <button class="nav__menu" aria-label="Open menu" aria-expanded="false" aria-controls="mobil"><span></span><span></span></button>
</header>
<div class="mobil" id="mobil" hidden>
  {SITE.nav.map((n) => <a href={n.href}>{n.label}</a>)}
</div>
