---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="phero" style="padding-bottom:var(--sec)">
    <div class="wrap" style="display:grid;justify-items:center;gap:22px">
      <img src="/img/tuggy.webp" alt="Tuggy the tow truck" width="755" height="695" style="width:min(360px,80%)" class="big-char" />
      <p class="eyebrow">Error 404</p>
      <h1>Oh no! This page got stuck.</h1>
      <p class="lead">Tuggy is pulling it out… meanwhile, let’s go back home!</p>
      <a class="btn btn--red" href="/">Back to Vumibo Town</a>
    </div>
  </section>
</Base>
